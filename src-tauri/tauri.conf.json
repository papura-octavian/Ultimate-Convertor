{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate Convertor",
  "version": "1.0.0",
  "identifier": "space.skipit.ultimateconvertor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ultimate Convertor",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0a0a12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SkipIt",
    "homepage": "https://skipit.space",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Convert anything, fast",
    "longDescription": "Convert images, video, audio, data and documents in bulk, plus units, numbers and colors.",
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
